{
  "name": "@worksong/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worksong design tokens and control primitives, shared by the Worksong app and bot mobile.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./tokens": { "types": "./dist/tokens/index.d.ts", "default": "./dist/tokens/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
